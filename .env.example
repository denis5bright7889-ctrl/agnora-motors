# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is already in .gitignore.

# ── Database (Neon PostgreSQL) ──────────────────────────────
# Get from: https://neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── NextAuth v5 ──────────────────────────────────────────────
# Generate: openssl rand -base64 32
# AUTH_SECRET is the canonical v5 name; NEXTAUTH_SECRET kept as fallback.
AUTH_SECRET=your-random-secret-here
NEXTAUTH_SECRET=your-random-secret-here

# AUTH_URL MUST be set in Vercel for custom domains.
# Vercel auto-detects the URL for *.vercel.app deployments, but for a custom
# domain (agnora-motors.com) you must set this explicitly in Vercel →
# Settings → Environment Variables, otherwise OAuth callbacks use the wrong
# origin and Google authentication loops back to the login page.
#
# Local dev:
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Production (set in Vercel dashboard, not committed):
# AUTH_URL=https://agnora-motors.com
# AUTH_TRUST_HOST=1

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
#
# Authorized redirect URIs — add ALL of these in Google Console:
#   http://localhost:3000/api/auth/callback/google      (local dev)
#   https://<project>.vercel.app/api/auth/callback/google  (preview)
#   https://agnora-motors.com/api/auth/callback/google  (production)
#
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://agnora-motors.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Cloudinary (image uploads) ──────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Admin credentials ─────────────────────────────────────────
# Generate hash: node -e "require('bcryptjs').hash('YourPassword', 12).then(console.log)"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=bcrypt-hash-of-your-password
ADMIN_NAME=Your Admin Name

# ── Resend (transactional email / OTP delivery) ──────────────────────────
# Get from: https://resend.com → API Keys → Create API Key
# The key must have "Send Email" permission.
# CRITICAL: also add this to Vercel → Settings → Environment Variables
# (it is NOT in .env.local by default — if missing, OTP emails will never send)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

#── NewsPub API Key (for fetching car news) ──────────────────────────────
NEWSAPI_KEY=        # newsapi.org free tier (100 req/day)
GNEWS_KEY=          # gnews.io free tier (100 req/day)
CRON_SECRET=        # any secret string — protects cron endpoints
NEXT_PUBLIC_BASE_URL=https://agnora-motors.com

# ── Photo verification & quality scoring ─────────────────────────────────
# All optional. With none set, the pipeline still works: file-signature
# checks, blank-image detection, dimension limits, duplicate hashing and
# quality scoring all run locally with no configuration.

# Vehicle detection. Three modes, in precedence order:
#
#   VEHICLE_CLASSIFIER=onnx   Local MobileNetV2 via ONNX. Nothing leaves the
#                             server: no API key, no per-call cost, no seller
#                             photo sent anywhere. Requires a one-off
#                             `npm run detect:setup` (downloads a 13.3 MB
#                             model) plus `npm install onnxruntime-web`.
#   VEHICLE_CLASSIFIER_URL    An HTTP endpoint. Use this when the runtime does
#                             not fit in the function bundle (it unpacks to
#                             ~145 MB): run the detector as a sidecar and point
#                             this at it.
#   neither set               No classification. Photos are recorded as
#                             'unchecked' and upload behaviour is exactly as it
#                             was before detection existed.
#
# Detection stays OFF by default on purpose: turning it on changes what gets
# published, so it is an explicit decision rather than something that switches
# itself on because a model file happens to be present.
VEHICLE_CLASSIFIER=
VEHICLE_MODEL_PATH=.models/mobilenetv2-12.onnx

# An HTTP endpoint accepting raw image bytes, returning either
#   {"label":"vehicle"|"not_vehicle","score":0..1}
# or {"labels":[{"name":"car","confidence":0.9}, ...]}
VEHICLE_CLASSIFIER_URL=
VEHICLE_CLASSIFIER_TOKEN=     # optional bearer token for the endpoint above
VEHICLE_CLASSIFIER_ACCEPT=0.75  # min confidence to auto-approve a vehicle photo
VEHICLE_CLASSIFIER_REJECT=0.85  # min confidence to auto-reject a non-vehicle

# Local-detector tuning. Measured on real photographs: car exteriors and a
# wheel close-up scored 0.977-0.985; a building 0.045; documents, a dog, a
# chair and food 0.000-0.003. Crucially, an engine bay scored 0.303 and a
# dashboard 0.169 — both legitimate listing photos that ImageNet has no class
# for — so a low score alone must never reject. Rejection additionally
# requires a confident non-vehicle top-1 class.
VEHICLE_DETECT_MIN=0.5           # at/above this summed probability => vehicle
VEHICLE_DETECT_NEGATIVE_MAX=0.02 # below this AND a confident other subject => reject
VEHICLE_DETECT_TOP1_MIN=0.25     # min top-1 probability to count as that evidence

# Image quality thresholds. Defaults shown; these are starting points tuned
# against ordinary phone-camera photos, not universal standards. Override to
# retune without a code change.
IMAGE_MIN_WIDTH=640           # hard floor — smaller images are rejected
IMAGE_MIN_HEIGHT=480
IMAGE_SCORE_GOOD=80           # 80-100 good
IMAGE_SCORE_ACCEPTABLE=60     # 60-79  acceptable
IMAGE_SCORE_REVIEW=40         # 40-59  manual review; below 40 rejected
IMAGE_BLUR_VARIANCE=120       # Laplacian variance below this reads as blurry
IMAGE_FLAT_STDDEV=12          # std dev below this reads as flat/uniform
IMAGE_CLIP_FRACTION=0.25      # clipped-pixel fraction that forces review
